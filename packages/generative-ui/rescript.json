{
  "name": "@vibespace/generative-ui",
  "sources": [
    {
      "dir": "src",
      "subdirs": true
    }
  ],
  "gentypeconfig": {
    "module": "esmodule",
    "moduleResolution": "node",
    "generatedFileExtension": ".gen.tsx"
  },
  "dependencies": [
    "@rescript/webapi"
  ],
  "package-specs": {
    "module": "esmodule",
    "in-source": true
  },
  "suffix": ".res.js",
  "reanalyze": {
    "analysis": ["dce"],
    "suppress": [],
    "unsuppress": [],
    "transitive": false
  }
}
