# Optional backend-only OpenAI key for local assistant generation.
# Put real local values in ignored .env.secrets.local or .envrc.private,
# not generated .env.local.
OPENAI_API_KEY=
SEND_SUPABASE_URL=
SEND_SUPABASE_ANON_KEY=

# Generated by localnet for normal Tilt runs.
HTTP_PORT=4555
FRONTEND_PORT=5177
VIBESPACE_GRAPHQL_PUBLIC_URL=http://127.0.0.1:4555/graphql
VITE_GRAPHQL_ENDPOINT=http://127.0.0.1:4555/graphql
VITE_SEND_SUPABASE_URL=
VITE_SEND_SUPABASE_ANON_KEY=
VIBESPACE_SESSION_SECRET=local-dev-session-secret
VIBESPACE_DEV_ADMIN_TOKEN=local-dev-admin-token
