{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "corepack yarn install --immutable",
  "buildCommand": "corepack yarn workspace @vibespace/web build",
  "outputDirectory": "apps/web/dist",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
