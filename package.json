{
  "name": "vibespace",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "yarn@4.3.1",
  "workspaces": [
    "api/*",
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "yarn workspace @vibespace/web dev",
    "build": "yarn workspace @vibespace/web build",
    "preview": "yarn workspace @vibespace/web preview",
    "rescript": "rescript build packages/generative-ui && rescript build packages/schema && rescript build api/graphql && rescript build apps/web",
    "rescript:watch": "yarn workspace @vibespace/web rescript:watch",
    "reanalyze": "node scripts/reanalyze-all.js -dce",
    "reanalyze:json": "node scripts/reanalyze-all.js -dce -json",
    "reanalyze:report": "node scripts/reanalyze-report.js",
    "reanalyze:report:allow": "node scripts/reanalyze-report.js --max-warnings=0",
    "reanalyze:exception": "node scripts/reanalyze-all.js -exception",
    "reanalyze:exception:json": "node scripts/reanalyze-all.js -exception -json",
    "reanalyze:reactive": "node scripts/reanalyze-all.js -dce -reactive",
    "reanalyze:benchmark": "node scripts/reanalyze-all.js -dce -reactive -timing -runs 3",
    "reanalyze:mermaid": "node scripts/reanalyze-all.js -dce -reactive -no-transitive -mermaid",
    "db:schema:bootstrap": "bash scripts/db-schema-bootstrap.sh",
    "db:schema:plan": "bash scripts/db-schema-plan.sh",
    "db:schema:apply": "bash scripts/db-schema-apply.sh",
    "db:schema:apply:file": "PGSCHEMA_APPLY_MODE=file bash scripts/db-schema-apply.sh",
    "pgtyped": "pgtyped-rescript -c pgtyped.config.json",
    "pgtyped:watch": "pgtyped-rescript -w -c pgtyped.config.json",
    "rescript:generative-ui": "rescript build packages/generative-ui",
    "rescript:backend": "yarn rescript:generative-ui && rescript build packages/schema && rescript build api/graphql",
    "rescript:backend:watch": "yarn workspace @vibespace/graphql rescript:watch",
    "resgraph": "yarn rescript:backend && yarn workspace @vibespace/graphql resgraph",
    "resgraph:watch": "yarn rescript:backend && yarn workspace @vibespace/graphql resgraph:lsp",
    "relay": "node scripts/relay-command.js",
    "relay:validate": "yarn workspace @vibespace/web relay:validate",
    "relay:watch": "yarn workspace @vibespace/web relay:watch",
    "router": "yarn workspace @vibespace/web router",
    "router:validate": "yarn workspace @vibespace/web router:validate",
    "router:watch": "yarn workspace @vibespace/web router:watch",
    "backend:dev": "yarn resgraph && bun api/graphql/src/BackendServer.res.js",
    "backend:container:check": "yarn resgraph && yarn relay:validate && yarn router:validate",
    "backend:check": "yarn backend:container:check",
    "localnet:gen": "node scripts/localnet-gen-env.js",
    "localnet:up": "bash scripts/localnet-up.sh",
    "localnet:down": "bash scripts/localnet-down.sh",
    "localnet:open": "direnv exec . sh -lc 'open \"http://127.0.0.1:${TILT_PORT:-10350}\"'",
    "localnet:reset": "yarn localnet:down && yarn localnet:up",
    "test": "yarn rescript:backend && vitest run",
    "check": "yarn workspace @vibespace/web check"
  },
  "devDependencies": {
    "@rescript/tools": "0.6.6",
    "pgtyped-rescript": "^2.6.0",
    "rescript": "12.2.0",
    "vitest": "^4.1.6"
  }
}
