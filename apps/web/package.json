{
  "name": "@vibespace/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "rescript && vite",
    "build": "rescript && vite build",
    "preview": "vite preview",
    "vite": "vite",
    "rescript": "rescript",
    "rescript:watch": "rescript watch",
    "reanalyze": "cd ../.. && yarn reanalyze",
    "reanalyze:json": "cd ../.. && yarn reanalyze:json",
    "reanalyze:report": "cd ../.. && yarn reanalyze:report",
    "reanalyze:report:allow": "cd ../.. && yarn reanalyze:report:allow",
    "reanalyze:exception": "cd ../.. && yarn reanalyze:exception",
    "reanalyze:exception:json": "cd ../.. && yarn reanalyze:exception:json",
    "reanalyze:reactive": "cd ../.. && yarn reanalyze:reactive",
    "reanalyze:benchmark": "cd ../.. && yarn reanalyze:benchmark",
    "reanalyze:mermaid": "cd ../.. && yarn reanalyze:mermaid",
    "relay": "node ../../scripts/relay-command.js",
    "relay:validate": "sh ../../scripts/relay-no-watchman.sh relay.config.json --validate",
    "relay:watch": "rescript-relay-compiler relay.config.json --watch",
    "router": "rescript-relay-router generate -scaffold-renderers",
    "router:validate": "rescript-relay-router dump-routes --include-name --include-route-renderer-path",
    "router:watch": "rescript-relay-router generate -scaffold-renderers --watch",
    "check": "yarn reanalyze:report && vite build"
  },
  "dependencies": {
    "@base-ui/react": "^1.4.1",
    "@rescript/react": "0.15.0",
    "@rescript/runtime": "12.2.0",
    "@rescript/webapi": "0.1.0-experimental-0781ac8",
    "@tailwindcss/vite": "^4.3.0",
    "@types/react": "19.2.14",
    "@vibespace/generative-ui": "workspace:*",
    "@vitejs/plugin-react": "5.1.0",
    "html-to-image": "^1.11.13",
    "html-validate": "^10.16.0",
    "lightningcss-wasm": "^1.32.0",
    "lucide-react": "^1.14.0",
    "quansync": "0.2.11",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-relay": "20.1.1",
    "relay-runtime": "20.1.1",
    "rescript-base-ui": "^1.2.5",
    "rescript-relay": "^4.4.1",
    "rescript-relay-router": "^3.1.0",
    "shadcn": "^4.7.0",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.0",
    "tw-animate-css": "^1.4.0",
    "vite": "7.2.7",
    "zod": "4.2.1"
  },
  "devDependencies": {
    "@rescript/tools": "0.6.6",
    "relay-compiler": "20.1.1",
    "rescript": "12.2.0"
  }
}
